{
  "name": "@frame-app/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:fastify --external:@supabase/supabase-js --external:zod",
    "start": "node dist/server.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@frame-app/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0"
  }
}
