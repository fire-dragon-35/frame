# Local values come from `supabase start` (run `supabase status`). Never commit real credentials.
SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe (publishable/anon) key:
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser. Only used for narrowly scoped privileged operations.
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_SECRET=change-me
PORT=3001

# Frontend (Vite exposes only VITE_* variables to the browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001
